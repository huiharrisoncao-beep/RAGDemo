# ===== Chat（生成）配置：OpenAI 兼容 API =====
# DeepSeek 示例（DeepSeek 无 embedding 接口，embedding 请用 local 兜底）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-api-key-here
CHAT_MODEL=deepseek-chat

# ===== Embedding 配置：与 chat 解耦 =====
# EMBEDDING_PROVIDER: local | openai
#   local  -> 使用本地 sentence-transformers（离线、无需 embedding API）
#   openai -> 使用 OpenAI 兼容 embedding 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# 当 EMBEDDING_PROVIDER=openai 时可单独指定（缺省复用上面的 OPENAI_* ）
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-embedding-key

# ===== 语料语言：cn | en =====
CORPUS_LANG=cn
